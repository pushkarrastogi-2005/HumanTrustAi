{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run HumanTrust Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--reload-dir",
        ".",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
