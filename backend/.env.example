# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=humantrust

# Engine Timing & Verification Settings
CHECK_INTERVAL_S=3
SAVE_MEDIA=1
EVIDENCE_ENABLED=1
EVIDENCE_COOLDOWN_S=30

# Cloudinary Storage Configuration (for forensic evidence snapshots)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Phase 3 AI Parameters (Optional overrides)
IDENTITY_ENABLED=1
DEEPFAKE_ENABLED=1
DEEPFAKE_MODEL=prithivMLmods/Deep-Fake-Detector-v2-Model
DEEPFAKE_EVERY_N=3
DEEPFAKE_FAKE_FLOOR=0.65
AUTH_WEIGHT=0.50
